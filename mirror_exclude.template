# Folder Mirror Exclude Template
# 排除规则文件模板 - 指定不需要同步的文件和目录
# 每行一个规则，支持通配符
# 以 # 开头的行为注释

# 系统目录
/media/
/mnt/
/proc/
/sys/
/dev/
/tmp/

# 版本控制目录
.git/
.svn/
.hg/
.bzr/

# 构建输出目录
*/build/*
*/dist/*
*/target/*
*/out/*
*/bin/*
*/obj/*

# 依赖目录
node_modules/
vendor/
bower_components/
.venv/
venv/
env/

# IDE 和编辑器文件
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 日志文件
*.log
*.log.*
logs/

# 临时文件
*.tmp
*.temp
*.cache
.cache/

# 大文件
*.iso
*.dmg
*.img
*.vmdk

# 备份文件
*.bak
*.backup
*.old

# 特定项目或目录（根据需要自定义）
# */myproject/*
# etc/fstab*
# boot/grub/grub.cfg

# Folder Mirror 自身的文件
.folder_mirror_marker
.folder_mirror.log